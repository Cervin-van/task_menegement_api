APP_NAME=Task Management API
DEBUG=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tasks
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/tasks
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

JWT_SECRET_KEY=change-me-to-a-long-random-string
